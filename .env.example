# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Models
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-large
# Alterar as dimensões exige reingestão das políticas.
EMBEDDING_DIMENSIONS=3072

# Agent
# Valores aceitos pelo gpt-6-luna: none, low, medium, high, xhigh, max.
REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=4000
MAX_TOOL_ITERATIONS=6

# Application
DATABASE_PATH=data/app.db
APP_TIMEZONE=America/Campo_Grande
HOST=127.0.0.1
PORT=8000
# Use true para rodar sem chamar a API de embeddings (busca apenas FTS5).
SKIP_EMBEDDINGS=false
