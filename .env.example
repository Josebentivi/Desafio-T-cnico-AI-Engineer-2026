# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Models
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-large
# Changing dimensions requires re-running policy ingestion.
EMBEDDING_DIMENSIONS=3072

# Agent
# Values accepted by gpt-6-luna: none, low, medium, high, xhigh, max.
REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=4000
MAX_TOOL_ITERATIONS=6

# Application
DATABASE_PATH=data/app.db
APP_TIMEZONE=America/Campo_Grande
HOST=127.0.0.1
PORT=8000
# Set to true to run without calling the embeddings API (FTS5 only).
SKIP_EMBEDDINGS=false
